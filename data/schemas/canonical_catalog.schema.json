{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://core-keeper-archipelago.invalid/schemas/canonical_catalog.schema.json",
  "title": "Core Keeper Archipelago Canonical Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "milestones", "objects", "checks", "rewards"],
  "properties": {
    "schema_version": {"const": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core_keeper_steam_build_id", "source_manifest_sha256"],
      "properties": {
        "core_keeper_steam_build_id": {"type": "integer", "minimum": 1},
        "source_manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "milestones": {
      "type": "array",
      "items": {"$ref": "#/$defs/milestone"}
    },
    "objects": {
      "type": "array",
      "items": {"$ref": "#/$defs/object"}
    },
    "checks": {
      "type": "array",
      "items": {"$ref": "#/$defs/check"}
    },
    "rewards": {
      "type": "array",
      "items": {"$ref": "#/$defs/reward"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source", "locator", "sha256"],
      "properties": {
        "status": {"enum": ["verified", "observed", "blocked"]},
        "source": {"enum": ["game_config", "game_assembly", "game_asset", "test_world", "user_requirement", "archipelago_spec", "poptracker_spec", "integration_contract"]},
        "locator": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "note": {"type": "string"}
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all_of", "any_of"],
      "properties": {
        "all_of": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "any_of": {
          "type": "array",
          "items": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "display_name", "evidence"],
      "properties": {
        "key": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "display_name": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "object_id", "internal_name", "display_name", "kind", "evidence"],
      "properties": {
        "key": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "object_id": {"type": "integer", "minimum": 0},
        "variation": {"type": "integer", "minimum": 0},
        "internal_name": {"type": "string", "minLength": 1},
        "display_name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["item", "enemy", "boss", "station", "merchant", "pet", "other"]},
        "acquisition": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "source_key", "requirement", "evidence"],
            "properties": {
              "kind": {"enum": ["drop", "craft", "fish", "shop", "spawn", "interaction", "other"]},
              "source_key": {"type": "string", "minLength": 1},
              "requirement": {"$ref": "#/$defs/requirement"},
              "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
            }
          }
        },
        "sprite_key": {"type": ["string", "null"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "stable_id", "display_name", "group", "goal_scope", "normal", "sequence_break", "trigger", "evidence"],
      "properties": {
        "key": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "stable_id": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "display_name": {"type": "string", "minLength": 1},
        "group": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "goal_scope": {"enum": ["lower_wall", "core_commander", "sahabar", "all_bosses"]},
        "normal": {"$ref": "#/$defs/requirement"},
        "sequence_break": {"oneOf": [{"$ref": "#/$defs/requirement"}, {"type": "null"}]},
        "trigger": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "target_key"],
          "properties": {
            "kind": {"enum": ["natural_acquisition", "kill", "unlock", "talk", "skill_level", "world_event"]},
            "target_key": {"type": "string", "minLength": 1}
          }
        },
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "reward": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "stable_id", "display_name", "classification", "delivery", "evidence"],
      "properties": {
        "key": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "stable_id": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "display_name": {"type": "string", "minLength": 1},
        "classification": {"enum": ["filler", "useful", "progression", "progression_useful"]},
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {"enum": ["object", "cache", "skill_points", "license", "empty"]},
            "target_key": {"type": ["string", "null"]},
            "amount": {"type": "integer", "minimum": 0}
          }
        },
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      }
    }
  }
}
